  "loads": [
    {
      "path": "1. current version",
      "note": "reads straight back; nothing is written and nothing is backed up",
      "before": {
        "planet-rush:profile": "{\"v\":1,\"xp\":9646,\"level\":6,\"matches\":20}",
        "planet-rush:profile.bak": null
