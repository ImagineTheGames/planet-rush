{
  // Typecheck gate for the allocator's container build (allocator/Dockerfile).
  // OWNER: Netcode Engineer. The root tsconfig's `include` covers src/server/
  // tests but not allocator/, and the Docker build stage copies only src/ and
  // allocator/ (not tests/) — so the root config would leave the allocator's own
  // code unchecked in the image build. This config inherits every strict option
  // from the root and points `include` at exactly what the build stage has:
  // src/ (for the imported ticket/room-code/@shared code) and allocator/.
  //
  //   npx tsc --noEmit -p allocator/tsconfig.json
  //
  // The repo-wide `npx tsc --noEmit` (root config) still checks the allocator too
  // — the allocator's tests import its modules, pulling them into that program.
  //
  // TESTS ARE EXCLUDED, and that is load-bearing (a1-03). `include: ["../src"]`
  // swept in every `src/**/*.test.ts`, and those tests import `harness/` — a
  // top-level dir the build stage does not COPY and should not: it is the
  // determinism/soak/bench tooling, not allocator runtime code. So the image
  // typechecked files whose imports the image cannot resolve, and every
  // `Deploy server (Fly.io)` run failed at `docker build` from 2026-08-07 to
  // 2026-08-09 while `npx tsc --noEmit` stayed green on every lane and on main
  // (LESSONS §12: typecheck-in-image catches what typecheck-on-host cannot).
  //
  // The allocator never runs a test, so this program has no business compiling
  // one. The tests themselves stay fully checked by the repo-wide `npx tsc
  // --noEmit` in CI, where `harness/` exists. If you widen `include` here,
  // widen the Dockerfile's COPY set to match — or the deploy goes red again.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // baseUrl relative to this file (the repo root) so the aliases resolve the
    // same way they do from the root config.
    "baseUrl": "..",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@platform/*": ["src/platform/*"],
      "@render/*": ["src/render/*"]
    }
  },
  "include": ["../src", "../allocator"],
  "exclude": ["../src/**/*.test.ts", "../allocator/**/*.test.ts"]
}
