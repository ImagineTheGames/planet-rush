# Dependencies
node_modules/

# Build output
dist/
# The online live-stage suite's client bundle — the same build with an allocator
# URL baked in, kept out of dist/ so it never overwrites the offline artifact
# (tests/live-stage-online/).
dist-online-stage/

# Vite / test caches
.vite/
coverage/

# Playwright (mobile-emulation suite) output
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS cruft
.DS_Store
*.log

# The alarm-ownership live-stage spec's client bundle (tests/live-stage/
# alarm-fleet.ts) — the same build with its own allocator URL baked in, kept out
# of dist/ so it never overwrites the offline artifact.
dist-alarm-stage/

# The a0-14 evidence capture's client bundle (evidence/a0-14-hangar/) — the same
# build, served on a private port so a stale preview on the shared 4173 can never
# be what a capture is taken against. Kept out of dist/ like the two above.
dist-a0-14/

# The a0-31 evidence capture's client bundle (evidence/a0-31-solo-no-open-slots/)
# — same story as dist-a0-14: a private outDir on a private port, so a capture
# can never be taken against another lane's preview.
dist-a0-31/

# The a0-79 evidence capture's two client bundles (evidence/a0-79-menus/) — this
# branch's and pristine `main`'s, built to private outDirs and served on private
# ports so the before/after frames and the frame-cost A/B can never be taken
# against another lane's preview. Same story as dist-a0-14 and dist-a0-31.
dist-a079-after/
dist-a079-before/

# a0-134: the before/after bundles the sightline evidence is photographed off —
# `origin/main` and this branch, each pointed at a local fleet, on private ports.
# Same story as every entry above, plus one more: `dist-a088/` was left untracked
# in this workspace by an earlier lane and a `git add -A` swept it into a commit,
# which is exactly the accident these lines exist to stop.
dist-a088/
dist-a0134-before/
dist-a0134-after/
