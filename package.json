{
  "name": "planet-rush",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Planet Rush — a top-down 2D space arena game. TypeScript + PixiJS, online and offline, desktop and mobile.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:mobile": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --no-experimental-strip-types\" playwright test",
    "test:perf-budget": "playwright test --config tests/perf/playwright.draw-budget.config.ts",
    "test:perf-frame-time": "playwright test --config tests/perf/playwright.perf.config.ts",
    "test:live": "playwright test --config tests/live/playwright.live.config.ts",
    "test:live-stage": "playwright test --config tests/live-stage/playwright.config.ts",
    "test:pin": "node tests/net/live-pin.probe.mjs --local 6",
    "test:connect-evidence": "playwright test --config tests/live-stage/playwright.connect-trace.config.ts",
    "test:link-loss-evidence": "playwright test --config tests/live-stage/playwright.link-loss.config.ts",
    "typecheck": "tsc --noEmit",
    "dark-matter": "node tools/dark-matter-scan.mjs",
    "dark-matter:check": "node tools/dark-matter-scan.mjs --check",
    "dark-matter:audit": "node tools/dark-matter-scan.mjs --audit"
  },
  "dependencies": {
    "pixi.js": "8.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@types/pngjs": "6.0.5",
    "pngjs": "7.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
